# Copy this file to `.env` (in the same folder as app.py) and fill in values.
# `.env` is already in .gitignore — never commit real keys.

# ============================================================
# xAI Grok API Key (PREFERRED for this project)
# ============================================================
# You need the **Chat** key (Grok 4.3 or similar vision-capable model).
#
# Why "Chat"?
# - Chat = Grok 4.3 → supports image *input* (vision). This is what we use
#   to read the alcohol label photos and extract text.
# - Build = Grok Build 0.1 → fast coding/agent model (text). Not used here.
# - Imagine = image *generation* (we don't generate labels, we read them).
# - Voice = voice features (not needed).
#
# How to get it:
# 1. Go to https://console.x.ai/ (or https://console.x.ai/team/default/api-keys)
# 2. Find the "Chat" product / capability (it should show as available).
# 3. Create / copy the API key for Chat.
# 4. Paste it below.
#
# The code will automatically use xAI first if this key is present.
XAI_API_KEY=your_xai_chat_key_here

# Optional: Force a specific Grok vision model
# XAI_VISION_MODEL=grok-4.3

# ============================================================
# OpenAI Fallback (only if you don't have xAI access)
# ============================================================
# OPENAI_API_KEY=sk-your-openai-key-here
# OPENAI_VISION_MODEL=gpt-4o          # or gpt-4o-mini (cheaper/faster)

# ============================================================
# Demo Mode (works with ZERO keys)
# ============================================================
# When true (or when no XAI/OPENAI key is found), the app uses the
# built-in realistic sample data for the 5 included test labels.
# This is the recommended setting while you are still getting your key,
# and for reliable demos/presentations.
USE_MOCK_MODE=true
